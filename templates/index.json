{
  "sections": {
    "slideshow": {
      "type": "slideshow",
      "blocks": {
        "slide_1": {
          "type": "_slide",
          "settings": {
            "image": "shopify://shop_images/IMG_3648.png",
            "image_mobile": "shopify://shop_images/IMG_3644.png",
            "link": "shopify://collections/all",
            "link_label": "Нова колекція — до каталогу",
            "show_content": false
          }
        },
        "slide_2": {
          "type": "_slide",
          "settings": {
            "link": "shopify://collections/best-sellers",
            "link_label": "Топ продаж",
            "show_content": false
          }
        }
      },
      "block_order": ["slide_1", "slide_2"],
      "settings": {
        "width": "full",
        "ratio_desktop": "12/5",
        "ratio_mobile": "4/5",
        "autoplay": true,
        "interval": 6,
        "color_scheme": "scheme-1",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "hero": {
      "type": "section",
      "blocks": {
        "hero_content": {
          "type": "group",
          "settings": { "gap": 24, "width": "fill" },
          "blocks": {
            "hero_eyebrow": {
              "type": "heading",
              "settings": { "text": "Матеріали для нарощення вій", "style": "eyebrow", "color": "muted" }
            },
            "hero_title": {
              "type": "heading",
              "settings": { "text": "Ідеальний погляд починається з *матеріалів*", "style": "display", "tag": "h1", "max_width": 22 }
            },
            "hero_text": {
              "type": "text",
              "settings": {
                "text": "<p>Вії, клей, пінцети, препарати та розхідники для лешмейкерів. Відправляємо в день замовлення.</p>",
                "size": "lg",
                "muted": true,
                "max_width": 48
              }
            },
            "hero_buttons": {
              "type": "group",
              "settings": { "direction": "row", "gap": 16, "width": "fit", "stack_mobile": true },
              "blocks": {
                "hero_primary": {
                  "type": "button",
                  "settings": { "label": "До шопінгу", "link": "shopify://collections/all", "style": "primary" }
                },
                "hero_secondary": {
                  "type": "button",
                  "settings": { "label": "Топ продаж", "link": "shopify://collections/best-sellers", "style": "secondary" }
                }
              },
              "block_order": ["hero_primary", "hero_secondary"]
            }
          },
          "block_order": ["hero_eyebrow", "hero_title", "hero_text", "hero_buttons"]
        },
        "hero_media": {
          "type": "image",
          "settings": { "ratio": "4/3", "desktop_size": 50 }
        }
      },
      "block_order": ["hero_content", "hero_media"],
      "settings": {
        "layout": "row",
        "align": "center",
        "gap": 56,
        "width": "page",
        "color_scheme": "scheme-1",
        "padding_top": 56,
        "padding_bottom": 24
      }
    },
    "benefits": {
      "type": "benefits",
      "blocks": {
        "benefit_shipping": {
          "type": "_benefit",
          "settings": { "title": "Відправка", "text": "В день замовлення, пн–пт" }
        },
        "benefit_delivery": {
          "type": "_benefit",
          "settings": { "title": "Доставка", "text": "Безкоштовно від 3000 грн" }
        },
        "benefit_cashback": {
          "type": "_benefit",
          "settings": { "title": "Кешбек", "text": "5% бонусами з кожного замовлення" }
