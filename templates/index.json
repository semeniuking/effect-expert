        "subheading": "Обирають лешмейкери",
        "heading": "Топ продаж",
        "link_label": "Дивитись усі",
        "link_url": "shopify://collections/best-sellers",
        "columns": 4,
        "mobile_layout": "rail",
        "color_scheme": "scheme-1",
        "padding_top": 80,
        "padding_bottom": 80
