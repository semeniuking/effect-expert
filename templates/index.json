        "cashback_buttons": {
          "type": "group",
          "settings": { "direction": "row", "gap": 16, "width": "fit", "stack_mobile": true },
          "blocks": {
            "cashback_primary": {
              "type": "button",
              "settings": { "label": "Увійти в кабінет", "link": "shopify://customers/account", "style": "accent" }
            },
            "cashback_secondary": {
              "type": "button",
              "settings": { "label": "Як це працює", "style": "secondary" }
            }
          },
          "block_order": ["cashback_primary", "cashback_secondary"]
        }
      },
      "block_order": ["cashback_content", "cashback_buttons"],
      "settings": {
        "layout": "row",
        "justify": "space-between",
        "align": "center",
        "gap": 32,
        "width": "page",
        "color_scheme": "scheme-1",
        "padding_top": 80,
        "padding_bottom": 80
