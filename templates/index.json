    },
    "expert": {
      "type": "section",
      "blocks": {
        "expert_media": {
          "type": "image",
          "settings": { "ratio": "1/1", "desktop_size": 50 }
        },
        "expert_content": {
          "type": "group",
          "settings": { "gap": 24, "padding_y": 64 },
          "blocks": {
            "expert_eyebrow": {
              "type": "heading",
              "settings": { "text": "Колекція", "style": "eyebrow", "color": "muted" }
            },
            "expert_title": {
              "type": "heading",
              "settings": { "text": "Expert", "style": "display", "tag": "h2", "color": "accent" }
            },
            "expert_text": {
              "type": "text",
              "settings": { "text": "<p>Ще більше вій в одній упаковці.</p>", "size": "lg" }
            },
            "expert_features": {
              "type": "text",
              "settings": {
                "text": "<ul><li>28 ліній</li><li>Коробка-органайзер</li><li>Mix / окремі довжини</li><li>Black, brunette, brown</li></ul>",
                "size": "md",
                "muted": true
              }
            },
            "expert_button": {
              "type": "button",
              "settings": { "label": "Обрати EXPERT", "link": "shopify://collections/eyelashes", "style": "primary" }
            }
          },
          "block_order": ["expert_eyebrow", "expert_title", "expert_text", "expert_features", "expert_button"]
        }
      },
      "block_order": ["expert_media", "expert_content"],
      "settings": {
        "layout": "grid",
        "columns": 2,
        "align": "center",
        "gap": 64,
        "width": "page",
        "color_scheme": "scheme-2",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "cashback": {
      "type": "section",
      "blocks": {
        "cashback_content": {
          "type": "group",
          "settings": { "gap": 12, "width": "fill" },
          "blocks": {
            "cashback_title": {
              "type": "heading",
              "settings": { "text": "*5%* кешбеку", "style": "h1", "tag": "h2" }
            },
            "cashback_text": {
              "type": "text",
              "settings": {
                "text": "<p>Купуйте матеріали — повертаємо бонусами з кожного замовлення. Списуйте при наступних покупках.</p>",
                "size": "lg",
                "muted": true,
                "max_width": 52
              }
            }
          },
          "block_order": ["cashback_title", "cashback_text"]
