{
  "printWidth": 120,
  "singleQuote": true,
  "plugins": ["@shopify/prettier-plugin-liquid"],
  "overrides": [
    { "files": "*.liquid", "options": { "singleQuote": false, "liquidSingleQuote": true } },
    { "files": ["locales/*.json", "templates/*.json", "sections/*.json", "config/*.json"], "options": { "printWidth": 1000 } }
  ]
}
