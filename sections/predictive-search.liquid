{%- comment -%}
  Predictive search results, rendered only through the Section Rendering API:
  {{ routes.predictive_search_url }}?q=…&section_id=predictive-search&resources[type]=product,collection,query&resources[limit]=6
  assets/predictive-search.js swaps [data-predictive-results] into the search dialog and copies [data-results-status]
  into the dialog's live region.
{%- endcomment -%}
{%- liquid
  assign products = predictive_search.resources.products
  assign collections = predictive_search.resources.collections
  assign queries = predictive_search.resources.queries
  assign total = products.size | plus: collections.size | plus: queries.size
  assign terms = predictive_search.terms | strip
  assign term_lower = terms | downcase | escape
-%}
<div class="predictive-search" data-predictive-results>
  {%- if predictive_search.performed -%}
    <p class="visually-hidden" data-results-status>
      {%- if total > 0 -%}
        {{- 'predictive_search.results_count' | t: count: total -}}
      {%- else -%}
        {{- 'predictive_search.no_results' | t: terms: terms -}}
      {%- endif -%}
    </p>

    {%- if total > 0 -%}
      {%- if queries.size > 0 -%}
        <div class="predictive-search__group">
          <p class="predictive-search__label" id="PredictiveQueries">{{ 'predictive_search.suggestions' | t }}</p>
          <ul class="predictive-search__queries" role="list" aria-labelledby="PredictiveQueries">
            {%- for query in queries -%}
              {%- liquid
                assign text = query.text | downcase | escape
                if term_lower != blank and text contains term_lower
                  assign bold = '<b>' | append: term_lower | append: '</b>'
                  assign text = text | replace_first: term_lower, bold
                endif
              -%}
              <li>
                <a class="predictive-search__query" href="{{ query.url }}" data-result>{{ text }}</a>
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      {%- if collections.size > 0 -%}
        <div class="predictive-search__group">
          <p class="predictive-search__label" id="PredictiveCollections">{{ 'predictive_search.collections' | t }}</p>
          <ul class="predictive-search__chips" role="list" aria-labelledby="PredictiveCollections">
            {%- for collection in collections -%}
              <li>
                <a class="chip" href="{{ collection.url }}" data-result>{{ collection.title | escape }}</a>
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      {%- if products.size > 0 -%}
        <div class="predictive-search__group">
          <p class="predictive-search__label" id="PredictiveProducts">{{ 'predictive_search.products' | t }}</p>
          <ul class="predictive-search__products" role="list" aria-labelledby="PredictiveProducts">
            {%- for product in products -%}
              <li>
                <a class="predictive-search__product" href="{{ product.url }}" data-result>
                  <div class="predictive-search__media media" style="--ratio: 1 / 1;">
                    {%- render 'image',
                      image: product.featured_image,
                      sizes: '56px',
                      widths: '56, 112, 168',
                      alt: '',
                      placeholder: 'product-1'
                    -%}
                  </div>
                  <div class="predictive-search__info">
                    <span class="predictive-search__title">{{ product.title | escape }}</span>
                    {% render 'price', product: product, show_from: true, class: 'predictive-search__price' %}
                  </div>
                </a>
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      <a
        class="button button--secondary button--full button--lg predictive-search__all"
        href="{{ routes.search_url }}?q={{ terms | url_encode }}&options%5Bprefix%5D=last"
        data-result
      >
        {{- 'predictive_search.view_all' | t: count: products.size -}}
      </a>
    {%- else -%}
      <p class="predictive-search__empty text-muted">{{ 'predictive_search.no_results' | t: terms: terms }}</p>
    {%- endif -%}
  {%- endif -%}
</div>

{% stylesheet %}
  .predictive-search {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .predictive-search__queries,
  .predictive-search__products {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .predictive-search__query {
    display: flex;
    align-items: center;
    min-height: 40px;
    color: inherit;
    font-size: 15px;
    text-decoration: none;
  }

  .predictive-search__query b {
    font-weight: var(--font-body-weight-bold);
  }

  .predictive-search__query:hover,
  .predictive-search__product:hover .predictive-search__title {
    color: var(--color-accent);
  }

  .predictive-search__product {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid var(--color-line);
    color: inherit;
    text-decoration: none;
  }

  .predictive-search__media {
    flex: none;
    width: 56px;
  }

  .predictive-search__info {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
  }

  .predictive-search__title {
    font-size: 14px;
    line-height: 19px;
    font-weight: var(--font-body-weight-bold);
  }

  .predictive-search .price {
    font-size: 13px;
    line-height: 18px;
    font-weight: var(--font-body-weight);
    color: var(--color-text-muted);
  }

  .predictive-search .price__sale {
    color: var(--color-sale);
  }

  .predictive-search__empty {
    font-size: 15px;
  }

  @media (min-width: 750px) {
    .predictive-search__products {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 32px;
    }
  }

  .predictive-search__label {
    padding-bottom: 8px;
    color: var(--color-text-muted);
    font-family: var(--font-display);
    font-size: 11px;
    line-height: 16px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .predictive-search__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .predictive-search__chips .chip {
    min-height: 40px;
    padding: 0 14px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.predictive_search.name"
}
{% endschema %}
