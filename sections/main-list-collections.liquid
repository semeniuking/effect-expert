{%- comment -%}
  All collections page (/collections): heading and a grid of collection tiles (image + uppercase label).
  Shows every collection sorted by the chosen order, or only the collections picked in the settings.
{%- endcomment -%}
{%- liquid
  if section.settings.collections != blank
    assign list = section.settings.collections
  else
    case section.settings.sort
      when 'products_high'
        assign list = collections | sort: 'all_products_count' | reverse
      when 'date_new'
        assign list = collections | sort: 'published_at' | reverse
      else
        assign list = collections | sort_natural: 'title'
    endcase
  endif
  assign cols = section.settings.columns
  assign sizes = '(min-width: 1100px) calc((min(100vw, 1344px) - 64px) / ' | append: cols | append: '), (min-width: 750px) calc((100vw - 112px) / 3), calc((100vw - 52px) / 2)'
-%}
<div
  class="section color-{{ section.settings.color_scheme }} list-collections"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="section__inner">
    {%- if section.settings.heading != blank -%}
      <h1 class="list-collections__title">{{ section.settings.heading | escape }}</h1>
    {%- endif -%}

    {%- if list.size > 0 -%}
      <ul
        class="grid list-collections__grid"
        role="list"
        style="--cols: {{ cols }}; --cols-tablet: 3; --cols-mobile: 2; --tile-ratio: {{ section.settings.ratio }};"
      >
        {%- for item in list limit: 100 -%}
          <li>
            <a class="tile" href="{{ item.url }}">
              <div class="tile__media media">
                {% render 'image',
                  image: item.featured_image,
                  sizes: sizes,
                  widths: '240, 360, 480, 640, 800',
                  alt: item.title,
                  placeholder: 'collection-1'
                %}
              </div>
              <span class="tile__label">{{ item.title | escape }}</span>
              {%- if section.settings.show_count -%}
                <span class="list-collections__count">{{ 'collections.product_count' | t: count: item.all_products_count }}</span>
              {%- endif -%}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p class="list-collections__empty">{{ 'collections.list_empty' | t }}</p>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .list-collections__title {
    margin-bottom: clamp(24px, 3vw, 40px);
  }

  .list-collections__grid {
    --grid-row-gap: 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .list-collections__count {
    margin-top: -6px;
    font-size: 13px;
    color: var(--color-text-muted);
  }

  .list-collections__empty {
    color: var(--color-text-muted);
  }

  @media (max-width: 749px) {
    .list-collections__grid {
      --grid-row-gap: 24px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.main_list_collections.name",
  "class": "shopify-section--list-collections",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:shared.heading.label",
      "default": "Каталог"
    },
    {
      "type": "select",
      "id": "sort",
      "label": "t:sections.main_list_collections.settings.sort.label",
      "options": [
        { "value": "alphabetical", "label": "t:sections.main_list_collections.settings.sort.options__alphabetical" },
        { "value": "products_high", "label": "t:sections.main_list_collections.settings.sort.options__products_high" },
        { "value": "date_new", "label": "t:sections.main_list_collections.settings.sort.options__date_new" }
      ],
      "default": "alphabetical"
    },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "t:sections.main_list_collections.settings.collections.label",
      "info": "t:sections.main_list_collections.settings.collections.info",
      "limit": 50
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "t:sections.main_list_collections.settings.show_count.label",
      "default": false
    },
    {
      "type": "header",
      "content": "t:shared.header_layout.content"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:shared.columns.label",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "t:shared.ratio.label",
      "options": [
        { "value": "4 / 5", "label": "t:sections.main_list_collections.settings.ratio.options__portrait" },
        { "value": "1 / 1", "label": "t:sections.main_list_collections.settings.ratio.options__square" },
        { "value": "3 / 4", "label": "t:sections.main_list_collections.settings.ratio.options__tall" }
      ],
      "default": "4 / 5"
    },
    {
      "type": "header",
      "content": "t:shared.header_appearance.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.padding_top.label",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.padding_bottom.label",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ]
}
{% endschema %}
