{%- comment -%}
  Password page: logo, opening message, newsletter signup and the storefront password form (inside <details>).
{%- endcomment -%}
{%- liquid
  assign logo_h = settings.logo_height
  if settings.logo != blank
    assign logo_ratio = settings.logo.aspect_ratio | default: 3
    assign logo_w = logo_h | times: logo_ratio | ceil
    assign logo_w2 = logo_w | times: 2
    assign logo_w3 = logo_w | times: 3
    assign logo_widths = logo_w | append: ', ' | append: logo_w2 | append: ', ' | append: logo_w3
    assign logo_sizes = logo_w | append: 'px'
  endif
-%}
<div
  class="section password color-{{ section.settings.color_scheme }}"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="section__inner password__inner">
    <div class="password__logo">
      {%- if settings.logo != blank -%}
        {{
          settings.logo
          | image_url: width: logo_w3
          | image_tag:
            class: 'password__logo-img',
            alt: shop.name,
            width: logo_w,
            height: logo_h,
            widths: logo_widths,
            sizes: logo_sizes,
            loading: 'eager'
        }}
      {%- else -%}
        <span class="password__shop-name">{{ shop.name | escape }}</span>
      {%- endif -%}
    </div>

    <div class="password__content">
      {%- if section.settings.heading != blank -%}
        <h1 class="password__heading h1">{{ section.settings.heading | escape }}</h1>
      {%- endif -%}
      {%- if shop.password_message != blank and section.settings.show_password_message -%}
        <p class="password__message text-lg text-muted">{{ shop.password_message | escape }}</p>
      {%- elsif section.settings.text != blank -%}
        <div class="password__message rte text-lg text-muted">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    {%- if section.settings.show_newsletter -%}
      <div class="password__signup">
        {%- form 'customer', id: 'PasswordSignup', class: 'password__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter, password-page">
          {%- if form.posted_successfully? -%}
            <p class="form-message form-message--success" role="status" tabindex="-1" autofocus>
              {{ 'password.signup_success' | t }}
            </p>
          {%- else -%}
            <label class="field__label" for="PasswordSignupEmail">{{ 'password.signup_label' | t }}</label>
            <div class="input-group">
              <input
                id="PasswordSignupEmail"
                class="input"
                type="email"
                name="contact[email]"
                autocomplete="email"
                required
                placeholder="{{ 'password.email_placeholder' | t }}"
                {% if form.errors %}
                  aria-invalid="true" aria-describedby="PasswordSignupError"
                {% endif %}
              >
              <button type="submit" class="button">{{ 'password.signup_button' | t }}</button>
            </div>
            {%- if form.errors -%}
              <p id="PasswordSignupError" class="form-message form-message--error">
                {{ form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email }}
              </p>
            {%- endif -%}
          {%- endif -%}
        {%- endform -%}
      </div>
    {%- endif -%}

    {%- form 'storefront_password', id: 'StorefrontPassword', class: 'password__enter' -%}
      <details class="password__details" {% if form.errors %}open{% endif %}>
        <summary class="password__summary link-arrow">
          {{- 'password.enter_with_password' | t -}}
          {% render 'icon', name: 'chevron-down', size: 14 %}
        </summary>
        <div class="password__enter-body">
          <label class="field__label" for="StorefrontPasswordInput">{{ 'password.password_label' | t }}</label>
          <div class="input-group">
            <input
              id="StorefrontPasswordInput"
              class="input"
              type="password"
              name="password"
              autocomplete="current-password"
              required
              {% if form.errors %}
                aria-invalid="true" aria-describedby="StorefrontPasswordError" autofocus
              {% endif %}
            >
            <button type="submit" class="button button--secondary">{{ 'password.enter' | t }}</button>
          </div>
          {%- if form.errors -%}
            <p id="StorefrontPasswordError" class="form-message form-message--error">
              {{ 'password.wrong_password' | t }}
            </p>
          {%- endif -%}
          <p class="password__admin text-xs text-muted">
            {{ 'password.admin_hint' | t }}
            <a href="/admin" class="password__admin-link">{{ 'password.admin_link' | t }}</a>
          </p>
        </div>
      </details>
    {%- endform -%}

    <p class="password__footer text-xs text-muted">
      &copy; {{ 'now' | date: '%Y' }}
      {{ shop.name | escape }}
      · {{ powered_by_link }}
    </p>
  </div>
</div>

{% stylesheet %}
  main:has(> .password-section) {
    display: flex;
    flex-direction: column;
  }

  .password-section {
    flex: 1 0 auto;
    display: flex;
    flex-direction: column;
  }

  .password {
    flex: 1;
    display: flex;
    align-items: center;
  }

  .password__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
    max-width: calc(520px + var(--gutter) * 2);
    text-align: center;
  }

  .password__logo-img {
    width: auto;
    height: var(--logo-height);
  }

  .password__shop-name {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .password__content {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .password__signup,
  .password__enter {
    width: 100%;
    text-align: left;
  }

  .password__form,
  .password__enter-body {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .password__summary {
    justify-content: center;
    gap: 8px;
    width: 100%;
    list-style: none;
    cursor: pointer;
    color: var(--color-text);
  }

  .password__summary::-webkit-details-marker {
    display: none;
  }

  .password__summary .icon {
    transition: transform var(--duration) var(--ease);
  }

  .password__details[open] .password__summary .icon {
    transform: rotate(180deg);
  }

  .password__enter-body {
    padding-top: 8px;
  }

  .password__admin {
    margin-top: 4px;
  }

  .password__footer a {
    color: inherit;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.password.name",
  "class": "password-section",
  "enabled_on": { "templates": ["password"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "t:shared.heading.label", "default": "Незабаром відкриття!" },
    {
      "type": "checkbox",
      "id": "show_password_message",
      "label": "t:sections.password.settings.show_password_message.label",
      "info": "t:sections.password.settings.show_password_message.info",
      "default": true
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.password.settings.text.label",
      "default": "<p>Готуємо для вас професійні матеріали для нарощування вій. Залиште email — повідомимо про відкриття першими.</p>"
    },
    { "type": "checkbox", "id": "show_newsletter", "label": "t:sections.password.settings.show_newsletter.label", "default": true },
    { "type": "header", "content": "t:shared.header_appearance.content" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:shared.color_scheme.label", "default": "scheme-2" },
    { "type": "range", "id": "padding_top", "label": "t:shared.padding_top.label", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "t:shared.padding_bottom.label", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 }
  ]
}
{% endschema %}
