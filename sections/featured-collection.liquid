{%- comment -%}
  Featured collection ("Топ продаж"): heading row + product cards.
  Desktop: grid. Mobile: swipe rail (164px cards) or a 2-column grid.
  Without a collection it shows placeholder cards so the layout can be previewed.
{%- endcomment -%}
{%- liquid
  assign featured = section.settings.collection
  assign limit = section.settings.products_count
  assign see_all_url = section.settings.link_url | default: featured.url
  assign rail = false
  if section.settings.mobile_layout == 'rail'
    assign rail = true
  endif
  assign cols = section.settings.columns
  assign cols_tablet = cols | at_most: 3
  assign mobile_size = '164px'
  unless rail
    assign mobile_size = '50vw'
  endunless
  assign sizes = '(min-width: 1100px) calc((min(100vw, 1440px) - 64px) / ' | append: cols | append: '), (min-width: 750px) 33vw, ' | append: mobile_size
-%}
<div
  class="section section--page color-{{ section.settings.color_scheme }} featured-collection"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="section__inner">
    {% render 'section-heading', settings: section.settings, link_url: see_all_url %}
    <div
      class="grid featured-collection__grid{% if rail %} grid--rail-mobile{% endif %}"
      style="--cols: {{ cols }}; --cols-tablet: {{ cols_tablet }}; --cols-mobile: 2; --rail-item: 164px;"
    >
      {%- if featured != blank -%}
        {%- for product in featured.products limit: limit -%}
          {% render 'product-card', product: product, sizes: sizes %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..limit) -%}
          {%- assign placeholder_index = i | modulo: 4 | plus: 1 -%}
          <article class="product-card product-card--placeholder">
            <div class="product-card__media">
              {{ 'product-' | append: placeholder_index | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
            <div class="product-card__body">
              <h3 class="product-card__heading text-sm">
                <span class="product-card__title">{{ 'sections.featured_collection.placeholder_title' | t }}</span>
              </h3>
              <span class="price">{{ 46000 | money_without_trailing_zeros }}</span>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .product-card--placeholder .product-card__title::after {
    content: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.featured_collection.name",
  "class": "shopify-section--featured-collection",
  "settings": [
    { "type": "collection", "id": "collection", "label": "t:shared.collection.label" },
    { "type": "range", "id": "products_count", "label": "t:shared.products_count.label", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "header", "content": "t:sections.featured_collection.settings.header_heading.content" },
    { "type": "text", "id": "subheading", "label": "t:shared.subheading.label", "default": "Обирають лешмейкери" },
    { "type": "text", "id": "heading", "label": "t:shared.heading.label", "default": "Топ продаж" },
    { "type": "text", "id": "link_label", "label": "t:shared.link_text.label", "default": "Дивитись усі" },
    {
      "type": "url",
      "id": "link_url",
      "label": "t:shared.link.label",
      "info": "t:sections.featured_collection.settings.link_url.info"
    },
    { "type": "header", "content": "t:shared.header_layout.content" },
    { "type": "range", "id": "columns", "label": "t:shared.columns.label", "min": 2, "max": 6, "step": 1, "default": 4 },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "t:shared.mobile_layout.label",
      "options": [
        { "value": "rail", "label": "t:shared.mobile_layout.options__rail" },
        { "value": "grid", "label": "t:shared.mobile_layout.options__grid" }
      ],
      "default": "rail"
    },
    { "type": "header", "content": "t:shared.header_appearance.content" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:shared.color_scheme.label", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "t:shared.padding_top.label", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "t:shared.padding_bottom.label", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 }
  ],
  "presets": [
    {
      "name": "t:sections.featured_collection.presets.name",
      "category": "t:categories.products"
    }
  ]
}
{% endschema %}
