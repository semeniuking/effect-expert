{%- comment -%}
  Flexible section: a container for any theme blocks. Most home page content (hero, cashback, image with text…)
  is built from this section's presets so everything stays rearrangeable.
{%- endcomment -%}
{%- liquid
  assign bg_image = section.settings.background_image
-%}
<div
  class="section section--{{ section.settings.width }} color-{{ section.settings.color_scheme }} flex-section{% if bg_image != blank %} flex-section--has-bg{% endif %}"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px; --gap: {{ section.settings.gap }}px; --cols: {{ section.settings.columns }}; --justify: {{ section.settings.justify }}; --align: {{ section.settings.align }}; --min-h: {{ section.settings.min_height }}px; --overlay: {{ section.settings.overlay | divided_by: 100.0 }};"
>
  {%- if bg_image != blank -%}
    <div class="flex-section__bg media" aria-hidden="true">
      {% render 'image', image: bg_image, sizes: '100vw', alt: '' %}
    </div>
  {%- endif -%}
  <div class="section__inner flex-section__inner flex-section__inner--{{ section.settings.layout }}">
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .flex-section {
    position: relative;
    isolation: isolate;
  }

  .flex-section__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: 0;
  }

  .flex-section__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-bg);
    opacity: var(--overlay);
  }

  .flex-section__inner {
    display: flex;
    gap: var(--gap);
    min-height: var(--min-h);
    justify-content: var(--justify);
    align-items: var(--align);
  }

  .flex-section__inner--column {
    flex-direction: column;
  }

  .flex-section__inner--row {
    flex-direction: row;
    flex-wrap: wrap;
  }

  .flex-section__inner--grid {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
  }

  @media (max-width: 749px) {
    .flex-section__inner--row {
      flex-direction: column;
      align-items: stretch;
    }

    .flex-section__inner--grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.section.name",
  "class": "shopify-section--flex",
  "blocks": [{ "type": "@theme" }, { "type": "@app" }],
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.section.settings.layout.label",
      "options": [
        { "value": "column", "label": "t:shared.direction.options__column" },
        { "value": "row", "label": "t:shared.direction.options__row" },
        { "value": "grid", "label": "t:sections.section.settings.layout.options__grid" }
      ],
      "default": "column"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:sections.section.settings.columns.label",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 2,
      "visible_if": "{{ section.settings.layout == 'grid' }}"
    },
    {
      "type": "select",
      "id": "justify",
      "label": "t:shared.justify.label",
      "options": [
        { "value": "flex-start", "label": "t:shared.alignment.options__start" },
        { "value": "center", "label": "t:shared.alignment.options__center" },
        { "value": "flex-end", "label": "t:shared.alignment.options__end" },
        { "value": "space-between", "label": "t:shared.alignment.options__space_between" }
      ],
      "default": "flex-start"
    },
    {
      "type": "select",
      "id": "align",
      "label": "t:shared.align.label",
      "options": [
        { "value": "flex-start", "label": "t:shared.alignment.options__start" },
        { "value": "center", "label": "t:shared.alignment.options__center" },
        { "value": "flex-end", "label": "t:shared.alignment.options__end" },
        { "value": "stretch", "label": "t:shared.alignment.options__stretch" }
      ],
      "default": "stretch"
    },
    { "type": "range", "id": "gap", "label": "t:shared.gap.label", "min": 0, "max": 96, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "min_height", "label": "t:sections.section.settings.min_height.label", "min": 0, "max": 900, "step": 20, "unit": "px", "default": 0 },
    { "type": "header", "content": "t:shared.header_appearance.content" },
    {
      "type": "select",
      "id": "width",
      "label": "t:shared.section_width.label",
      "options": [
        { "value": "page", "label": "t:shared.section_width.options__page" },
        { "value": "narrow", "label": "t:shared.section_width.options__narrow" },
        { "value": "full", "label": "t:shared.section_width.options__full" }
      ],
      "default": "page"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:shared.color_scheme.label", "default": "scheme-1" },
    { "type": "image_picker", "id": "background_image", "label": "t:sections.section.settings.background_image.label" },
    {
      "type": "range",
      "id": "overlay",
      "label": "t:sections.section.settings.overlay.label",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 0,
      "visible_if": "{{ section.settings.background_image != blank }}"
    },
    { "type": "range", "id": "padding_top", "label": "t:shared.padding_top.label", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "t:shared.padding_bottom.label", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 }
  ],
  "presets": [
    {
      "name": "t:sections.section.presets.empty",
      "category": "t:categories.layout"
    },
    {
      "name": "t:sections.section.presets.hero",
      "category": "t:categories.banners",
      "settings": { "layout": "row", "align": "center", "gap": 56, "padding_top": 56, "padding_bottom": 24 },
      "blocks": {
        "content": {
          "type": "group",
          "settings": { "gap": 24, "width": "fill" },
          "blocks": {
            "eyebrow": { "type": "heading", "settings": { "text": "Матеріали для нарощення вій", "style": "eyebrow", "color": "muted" } },
            "title": { "type": "heading", "settings": { "text": "Ідеальний погляд починається з *матеріалів*", "style": "display", "max_width": 22 } },
            "text": { "type": "text", "settings": { "text": "<p>Вії, клей, пінцети, препарати та розхідники для лешмейкерів. Відправляємо в день замовлення.</p>", "size": "lg", "muted": true, "max_width": 48 } },
            "buttons": {
              "type": "group",
              "settings": { "direction": "row", "gap": 16, "width": "fit", "stack_mobile": true },
              "blocks": {
                "primary": { "type": "button", "settings": { "label": "До шопінгу", "link": "shopify://collections/all", "style": "primary" } },
                "secondary": { "type": "button", "settings": { "label": "Топ продаж", "link": "shopify://collections/best-sellers", "style": "secondary" } }
              },
              "block_order": ["primary", "secondary"]
            }
          },
          "block_order": ["eyebrow", "title", "text", "buttons"]
        },
        "media": { "type": "image", "settings": { "ratio": "4/3", "desktop_size": 50 } }
      },
      "block_order": ["content", "media"]
    },
    {
      "name": "t:sections.section.presets.rich_text",
      "category": "t:categories.text",
      "settings": { "layout": "row", "justify": "space-between", "align": "center", "gap": 32, "padding_top": 80, "padding_bottom": 80 },
      "blocks": {
        "content": {
          "type": "group",
          "settings": { "gap": 12, "width": "fill" },
          "blocks": {
            "title": { "type": "heading", "settings": { "text": "*5%* кешбеку", "style": "h1" } },
            "text": { "type": "text", "settings": { "text": "<p>Купуйте матеріали — повертаємо бонусами з кожного замовлення. Списуйте при наступних покупках.</p>", "size": "lg", "muted": true, "max_width": 52 } }
          },
          "block_order": ["title", "text"]
        },
        "buttons": {
          "type": "group",
          "settings": { "direction": "row", "gap": 16, "width": "fit", "stack_mobile": true },
          "blocks": {
            "primary": { "type": "button", "settings": { "label": "Увійти в кабінет", "link": "shopify://customers/account", "style": "accent" } },
            "secondary": { "type": "button", "settings": { "label": "Як це працює", "style": "secondary" } }
          },
          "block_order": ["primary", "secondary"]
        }
      },
      "block_order": ["content", "buttons"]
    },
    {
      "name": "t:sections.section.presets.image_with_text",
      "category": "t:categories.banners",
      "settings": { "layout": "grid", "columns": 2, "align": "center", "gap": 64, "color_scheme": "scheme-2", "padding_top": 0, "padding_bottom": 0 },
      "blocks": {
        "media": { "type": "image", "settings": { "ratio": "1/1", "desktop_size": 50 } },
        "content": {
          "type": "group",
          "settings": { "gap": 24, "padding_y": 64 },
          "blocks": {
            "eyebrow": { "type": "heading", "settings": { "text": "Колекція", "style": "eyebrow", "color": "muted" } },
            "title": { "type": "heading", "settings": { "text": "Expert", "style": "display", "color": "accent" } },
            "text": { "type": "text", "settings": { "text": "<p>Ще більше вій в одній упаковці.</p>", "size": "lg" } },
            "button": { "type": "button", "settings": { "label": "Обрати EXPERT", "link": "shopify://collections/eyelashes", "style": "primary" } }
          },
          "block_order": ["eyebrow", "title", "text", "button"]
        }
      },
      "block_order": ["media", "content"]
    }
  ]
}
{% endschema %}
