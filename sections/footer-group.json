{
  "type": "footer",
  "name": "t:sections.footer_group.name",
  "sections": {
    "footer": {
      "type": "footer",
      "blocks": {
        "brand": {
          "type": "footer-brand",
          "settings": {
            "logo_height": 44,
            "text": "<p>Професійні матеріали для нарощування вій. Доставка Новою поштою та Укрпоштою по всій Україні.</p>",
            "show_social": true
          }
        },
        "menu-catalog": {
          "type": "menu",
          "settings": {
            "heading": "Каталог",
            "menu": "main-menu",
            "collapse_mobile": true
          }
        },
        "menu-customers": {
          "type": "menu",
          "settings": {
            "heading": "Покупцям",
            "menu": "footer",
            "collapse_mobile": true
          }
        },
        "contact": {
          "type": "contact-info",
          "settings": {
            "heading": "Звʼязок",
            "text": "",
            "collapse_mobile": true
          }
        },
        "newsletter": {
          "type": "group",
          "settings": {
            "direction": "column",
            "gap": 12,
            "width": "fill"
          },
          "blocks": {
            "newsletter-heading": {
              "type": "heading",
              "settings": {
                "text": "Новинки та акції",
                "style": "eyebrow",
                "tag": "h2",
                "color": "muted"
              }
            },
            "newsletter-text": {
              "type": "text",
              "settings": {
                "text": "<p>Підпишіться — перші дізнаєтесь про нові вії та знижки.</p>",
                "size": "sm",
                "muted": true
              }
            },
            "newsletter-form": {
              "type": "email-signup",
              "settings": {
                "placeholder": "Ваш email",
                "button_label": "OK"
              }
            }
          },
          "block_order": [
            "newsletter-heading",
            "newsletter-text",
            "newsletter-form"
          ]
        }
      },
      "block_order": [
        "brand",
        "menu-catalog",
        "menu-customers",
        "contact",
        "newsletter"
      ],
      "settings": {
        "columns": "1.4fr 1fr 1fr 1fr 1.4fr",
        "mobile_reorder": true,
        "color_scheme": "scheme-3",
        "padding_top": 64,
        "padding_bottom": 40
      }
    },
    "footer-bottom": {
      "type": "footer-bottom",
      "settings": {
        "show_policies": true,
        "show_payment_icons": true,
        "color_scheme": "scheme-3"
      }
    }
  },
  "order": [
    "footer",
    "footer-bottom"
  ]
}

