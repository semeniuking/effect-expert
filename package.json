{
  "name": "effect-expert-theme",
  "version": "1.0.0",
  "private": true,
  "description": "Effect Expert \u2014 custom Shopify theme (zero-build: Liquid + CSS + vanilla JS modules)",
  "scripts": {
    "dev": "shopify theme dev",
    "check": "shopify theme check",
    "check:node": "node scripts/theme-check.mjs",
    "format": "prettier --write \"**/*.{liquid,css,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{liquid,css,js,json,md}\"",
    "types": "tsc -p assets/jsconfig.json",
    "size": "node scripts/size-report.mjs"
  },
  "devDependencies": {
    "@shopify/prettier-plugin-liquid": "^1.6.0",
    "@shopify/theme-check-node": "^3.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0"
  },
  "type": "module"
}
