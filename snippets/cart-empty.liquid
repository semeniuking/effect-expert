{%- doc -%}
  Empty cart state: message, "До каталогу" button and, optionally, products from `settings.cart_empty_collection`.

  @param {string} [context] - 'drawer' (2 columns) or 'page' (4 columns)
  @param {string} [heading_tag] - tag for the message, default 'h2'

  @example
  {% render 'cart-empty', context: 'drawer' %}
{%- enddoc -%}
{%- liquid
  assign ctx = context | default: 'drawer'
  assign tag = heading_tag | default: 'h2'
  assign collection = settings.cart_empty_collection
  if ctx == 'page'
    assign product_limit = 4
    assign card_sizes = '(min-width: 1100px) calc((min(100vw, 1280px) - 72px) / 4), (min-width: 750px) 33vw, 50vw'
  else
    assign product_limit = 4
    assign card_sizes = '(min-width: 750px) 190px, 45vw'
  endif
-%}
<div class="cart-empty cart-empty--{{ ctx }}">
  <div class="cart-empty__message">
    <span class="cart-empty__icon" aria-hidden="true">{% render 'icon', name: 'cart', size: 28 %}</span>
    <{{ tag }} class="h3">{{ 'cart.empty.title' | t }}</{{ tag }}>
    <p class="text-muted text-sm">{{ 'cart.empty.text' | t }}</p>
    <a class="button" href="{{ routes.all_products_collection_url }}">{{ 'cart.empty.button' | t }}</a>
  </div>

  {%- if collection != blank and collection.products_count > 0 -%}
    <div class="cart-empty__products">
      <p class="eyebrow text-muted">{{ collection.title | escape }}</p>
      <ul class="grid cart-empty__grid" role="list" style="--cols-mobile: 2; --cols-tablet: {% if ctx == 'page' %}3{% else %}2{% endif %}; --cols: {% if ctx == 'page' %}4{% else %}2{% endif %};">
        {%- for product in collection.products limit: product_limit -%}
          <li>{% render 'product-card', product: product, sizes: card_sizes %}</li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .cart-empty {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .cart-empty__message {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding-block: 32px 8px;
    text-align: center;
  }

  .cart-empty__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    margin-bottom: 4px;
    border-radius: 50%;
    background: var(--color-surface);
  }

  .cart-empty__message .button {
    margin-top: 8px;
  }

  .cart-empty__products {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .cart-empty__grid {
    --grid-row-gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cart-empty--drawer .cart-empty__grid {
    column-gap: 12px;
  }

  .cart-empty--page .cart-empty__message {
    padding-block: 48px 16px;
  }
{% endstylesheet %}
