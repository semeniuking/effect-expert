{%- doc -%}
  Price for a product or variant: sale price in the sale color with the struck compare-at price, "from" for ranges, unit price.

  @param {product} [product] - product (uses its selected or first available variant)
  @param {variant} [variant] - variant to price (wins over product)
  @param {boolean} [show_from] - prefix "from" when the product's variants have different prices
  @param {string} [class] - extra classes

  @example
  {% render 'price', product: product, show_from: true %}
{%- enddoc -%}
{%- liquid
  assign target = variant | default: product.selected_or_first_available_variant
  assign price = target.price
  assign compare = target.compare_at_price
  assign on_sale = false
  if compare > price
    assign on_sale = true
  endif
  assign is_range = false
  if show_from and variant == blank and product.price_varies
    assign is_range = true
    assign price = product.price_min
  endif
-%}
<div class="price{% if class %} {{ class }}{% endif %}" data-price>
  {%- if on_sale and is_range == false -%}
    <span class="visually-hidden">{{ 'products.price.sale_price' | t }}</span>
    <span class="price__sale">{{ price | money }}</span>
    <span class="visually-hidden">{{ 'products.price.regular_price' | t }}</span>
    <s class="price__compare">{{ compare | money }}</s>
  {%- else -%}
    <span class="price__regular">
      {%- if is_range -%}
        {%- assign price_money = price | money -%}
        {{ 'products.price.from_price' | t: price: price_money }}
      {%- else -%}
        {{ price | money }}
      {%- endif -%}
    </span>
  {%- endif -%}
  {%- if target.unit_price_measurement -%}
    <span class="price__unit">
      {{- target.unit_price | money -}}
      /
      {%- if target.unit_price_measurement.reference_value != 1 -%}
        {{- target.unit_price_measurement.reference_value -}}
      {%- endif -%}
      {{- target.unit_price_measurement.reference_unit -}}
    </span>
  {%- endif -%}
</div>
