{%- doc -%}
  "Додати до замовлення": a placeholder that loads complementary products for the first cart item with
  assets/cart-upsell.js (from sections/cart-upsell.liquid via the product recommendations endpoint) once it scrolls into view.
  Products already in the cart are filtered out. Renders nothing when `settings.cart_show_upsell` is off or the cart is empty.

  @param {number} [limit] - maximum products to show, default 3

  @example
  {% render 'cart-upsell' %}
{%- enddoc -%}
{%- if settings.cart_show_upsell and cart.item_count > 0 -%}
  {%- liquid
    assign first_item = cart.items.first
    assign in_cart = cart.items | map: 'product_id' | uniq | join: ','
    assign max_items = limit | default: 3
  -%}
  <cart-upsell
    class="cart-upsell"
    data-url="{{ routes.product_recommendations_url }}?section_id=cart-upsell&product_id={{ first_item.product_id }}&intent=complementary&limit=6"
    data-exclude="{{ in_cart }}"
    data-limit="{{ max_items }}"
  >
    <div class="cart-upsell__inner" hidden>
      <h3 class="cart-upsell__heading">{{ 'cart.upsell.heading' | t }}</h3>
      <div class="cart-upsell__list" data-upsell-list></div>
    </div>
  </cart-upsell>
{%- endif -%}

{% stylesheet %}
  .cart-upsell {
    display: block;
  }

  .cart-upsell__inner {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 20px 0;
  }

  .cart-upsell__heading {
    font-family: var(--font-display);
    font-size: 12px;
    line-height: 16px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .cart-upsell__list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .cart-upsell__item {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .cart-upsell__media {
    flex: none;
    width: 56px;
    height: 56px;
  }

  .cart-upsell__info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .cart-upsell__title {
    color: var(--color-text);
    font-size: 14px;
    line-height: 20px;
    font-weight: var(--font-body-weight-bold);
    text-decoration: none;
  }

  .cart-upsell__title:hover {
    color: var(--color-accent);
  }

  .cart-upsell__price {
    font-size: 13px;
    line-height: 18px;
    color: var(--color-text-muted);
  }

  .cart-upsell__action {
    flex: none;
  }

  .cart-upsell__action .button {
    min-height: 44px;
    padding-inline: 14px;
  }

  @media (max-width: 749px) {
    .cart-upsell__media {
      width: 48px;
      height: 48px;
    }

    .cart-upsell__title {
      font-size: 13px;
      line-height: 18px;
    }

    .cart-upsell__price {
      font-size: 12px;
    }
  }
{% endstylesheet %}
