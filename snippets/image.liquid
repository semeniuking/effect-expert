{%- doc -%}
  Responsive image with srcset. Renders a placeholder SVG when the image is blank.

  @param {image} image - the image object
  @param {string} [sizes] - sizes attribute, default '100vw'
  @param {string} [widths] - comma-separated widths, default '360, 540, 720, 900, 1100, 1400, 1800, 2200'
  @param {string} [class] - classes on the img
  @param {string} [alt] - alt text override
  @param {boolean} [priority] - true for the LCP image (eager + fetchpriority=high)
  @param {string} [placeholder] - placeholder name for blank images, e.g. 'product-1', 'collection-1', 'lifestyle-1', 'image'
  @param {number} [max_width] - maximum rendered width (limits srcset)

  @example
  {% render 'image', image: section.settings.image, sizes: '(min-width: 750px) 50vw, 100vw', priority: true %}
{%- enddoc -%}
{%- liquid
  assign widths_list = widths | default: '360, 540, 720, 900, 1100, 1400, 1800, 2200'
  assign size_attr = sizes | default: '100vw'
  assign loading = 'lazy'
  assign fetch_priority = 'auto'
  if priority
    assign loading = 'eager'
    assign fetch_priority = 'high'
  endif
  assign alt_text = image.alt | escape
  unless alt == nil
    assign alt_text = alt | escape
  endunless
-%}
{%- if image != blank -%}
  {%- if max_width -%}
    {{ image | image_url: width: max_width | image_tag: widths: widths_list, sizes: size_attr, loading: loading, fetchpriority: fetch_priority, class: class, alt: alt_text }}
  {%- else -%}
    {{ image | image_url: width: 2200 | image_tag: widths: widths_list, sizes: size_attr, loading: loading, fetchpriority: fetch_priority, class: class, alt: alt_text }}
  {%- endif -%}
{%- else -%}
  {{ placeholder | default: 'image' | placeholder_svg_tag: 'placeholder-svg' }}
{%- endif -%}
