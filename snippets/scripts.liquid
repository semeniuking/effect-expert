{%- doc -%}
  Import map for theme ES modules and the small global config object used by them.

  @example
  {% render 'scripts' %}
{%- enddoc -%}
<script>
  document.documentElement.classList.replace('no-js', 'js');
  window.Theme = {
    routes: {
      root: {{ routes.root_url | json }},
      cart: {{ routes.cart_url | json }},
      cartAdd: {{ routes.cart_add_url | json }},
      cartChange: {{ routes.cart_change_url | json }},
      cartUpdate: {{ routes.cart_update_url | json }},
      search: {{ routes.search_url | json }},
      predictiveSearch: {{ routes.predictive_search_url | json }},
      productRecommendations: {{ routes.product_recommendations_url | json }}
    },
    cartType: {{ settings.cart_type | json }},
    moneyFormat: {{ shop.money_format | json }},
    locale: {{ request.locale.iso_code | json }},
    strings: {
      addToCart: {{ 'products.add_to_cart' | t | json }},
      soldOut: {{ 'products.sold_out' | t | json }},
      unavailable: {{ 'products.unavailable' | t | json }},
      cartError: {{ 'cart.error' | t | json }},
      added: {{ 'products.added' | t | json }}
    }
  };
</script>
<script type="importmap">
  {
    "imports": {
      "@theme/utils": "{{ 'utils.js' | asset_url }}",
      "@theme/cart": "{{ 'cart.js' | asset_url }}"
    }
  }
</script>
<link rel="modulepreload" href="{{ 'utils.js' | asset_url }}">
<script type="module" src="{{ 'global.js' | asset_url }}"></script>
