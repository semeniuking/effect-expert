{%- doc -%}
  Cart totals: automatic cart-level discounts, "Разом", the tax / shipping / cashback note and the checkout button.
  The checkout button is the standard `name="checkout"` submit of the `cart-form` form (the Get Checkout app hooks it).

  @param {string} [context] - 'drawer' adds the "Переглянути кошик" link

  @example
  {% render 'cart-summary', context: 'drawer' %}
{%- enddoc -%}
{%- liquid
  assign bonus = 0
  if settings.bonus_percent > 0
    assign bonus = cart.total_price | times: settings.bonus_percent | divided_by: 100 | divided_by: 100 | times: 100
  endif
-%}
<div class="cart-summary">
  {%- for discount in cart.cart_level_discount_applications -%}
    {%- if discount.type != 'discount_code' or settings.cart_show_discount == false -%}
      <div class="cart-summary__row">
        <span class="cart-summary__discount">
          {%- render 'icon', name: 'gift', size: 16 -%}
          {{- discount.title | escape -}}
        </span>
        <span class="cart-summary__discount-value">−{{ discount.total_allocated_amount | money_without_trailing_zeros }}</span>
      </div>
    {%- endif -%}
  {%- endfor -%}

  <div class="cart-summary__total">
    <span>{{ 'cart.summary.total' | t }}</span>
    <span class="cart-summary__total-price">{{ cart.total_price | money_without_trailing_zeros }}</span>
  </div>

  <p class="cart-summary__note">
    {%- if cart.taxes_included -%}
      {{- 'cart.summary.taxes_included' | t -}}
    {%- else -%}
      {{- 'cart.summary.taxes_at_checkout' | t -}}
    {%- endif %}
    {{ 'cart.summary.shipping_at_checkout' | t -}}
    {%- if bonus > 0 -%}
      {%- assign bonus_money = bonus | money_without_trailing_zeros %}
      {{ 'cart.summary.bonus' | t: amount: bonus_money -}}
    {%- endif -%}
  </p>

  <button
    type="submit"
    name="checkout"
    form="cart-form"
    class="button button--lg button--full cart-summary__checkout"
    {% if cart.item_count == 0 %}
      disabled
    {% endif %}
  >
    {{- 'cart.summary.checkout' | t -}}
  </button>

  {%- if context == 'drawer' -%}
    <a class="cart-summary__view" href="{{ routes.cart_url }}">{{ 'cart.summary.view_cart' | t }}</a>
  {%- endif -%}
</div>

{% stylesheet %}
  .cart-summary {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .cart-summary__row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    font-size: 14px;
  }

  .cart-summary__discount {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .cart-summary__discount-value {
    color: var(--color-sale);
    font-weight: var(--font-body-weight-bold);
    white-space: nowrap;
  }

  .cart-summary__total {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    font-size: 15px;
  }

  .cart-summary__total-price {
    font-size: 22px;
    line-height: 28px;
    font-weight: var(--font-body-weight-bold);
  }

  .cart-summary__note {
    font-size: 13px;
    line-height: 18px;
    color: var(--color-text-muted);
  }

  .cart-summary__view {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    margin-top: -4px;
    font-size: 13px;
    color: var(--color-text-muted);
  }

  .cart-summary__view:hover {
    color: var(--color-text);
  }

  @media (max-width: 749px) {
    .cart-summary {
      gap: 10px;
    }

    .cart-summary__total {
      font-size: 14px;
    }

    .cart-summary__total-price {
      font-size: 20px;
    }

    .cart-summary__note {
      font-size: 12px;
      line-height: 16px;
    }
  }
{% endstylesheet %}
