{%- doc -%}
  Quick-add dialog, rendered once by layout/theme.liquid. assets/quick-add.js opens it from any
  `[data-quick-add="<product url>"]` button and fills it with the `quick-add` section.
  Mobile: bottom sheet. Desktop: centered two-column modal.

  @example
  {% render 'quick-add-dialog' %}
{%- enddoc -%}
<quick-add-dialog>
  <dialog class="modal quick-add" aria-labelledby="QuickAddTitle">
    <span class="quick-add__handle" aria-hidden="true"></span>
    <button
      type="button"
      class="icon-button quick-add__close"
      data-quick-add-close
      aria-label="{{ 'accessibility.close' | t }}"
    >
      {%- render 'icon', name: 'close', size: 18 -%}
    </button>
    <div class="quick-add__content" data-quick-add-content tabindex="-1"></div>
  </dialog>
</quick-add-dialog>
<script type="module" src="{{ 'quick-add.js' | asset_url }}"></script>

{% stylesheet %}
  .quick-add {
    width: min(880px, calc(100vw - 48px));
    max-height: calc(100dvh - 48px);
    overflow: hidden;
  }

  .quick-add__content {
    max-height: inherit;
    height: 100%;
    outline: none;
  }

  .quick-add__close {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 2;
    border-radius: 50%;
    background: var(--color-bg);
  }

  .quick-add__close:focus:not(:focus-visible) {
    outline: none;
  }

  .quick-add__handle {
    display: none;
  }

  .quick-add[open] {
    animation: quick-add-in 0.2s var(--ease);
  }

  @keyframes quick-add-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  @media (max-width: 749px) {
    .quick-add {
      width: 100vw;
      max-width: 100vw;
      max-height: 88dvh;
      margin: auto 0 0;
      border-radius: var(--radius-card) var(--radius-card) 0 0;
    }

    .quick-add[open] {
      animation: drawer-in-bottom 0.25s var(--ease);
    }

    .quick-add__content {
      max-height: 88dvh;
      display: flex;
      flex-direction: column;
    }

    .quick-add__handle {
      display: block;
      position: absolute;
      top: 8px;
      left: 50%;
      width: 36px;
      height: 4px;
      margin-left: -18px;
      border-radius: 2px;
      background: var(--color-line);
    }

    .quick-add__close {
      top: 14px;
      right: 8px;
    }
  }
{% endstylesheet %}
