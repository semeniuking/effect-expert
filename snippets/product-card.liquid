{%- doc -%}
  Product card: square image well, badges, name, subtitle, price and an add / quick-add button.

  Subtitle comes from the `custom.subtitle` metafield; without it, a summary of the first two options
  (e.g. "C–M · 0.07–0.1") or the product type is shown.
  Badges: sale percentage, sold out, and any product tag written as `badge:Text` (e.g. `badge:Хіт`).

  @param {product} product - the product
  @param {string} [sizes] - image sizes attribute
  @param {boolean} [priority] - eager-load the image
  @param {boolean} [show_action] - show the add button (defaults to the theme setting)
  @param {string} [heading_tag] - tag for the product name, default 'h3'

  @example
  {% render 'product-card', product: product, sizes: '(min-width: 1100px) 25vw, 50vw' %}
{%- enddoc -%}
{%- liquid
  assign sizes_attr = sizes | default: '(min-width: 1100px) calc((min(100vw, 1280px) - 72px) / 4), (min-width: 750px) 33vw, 50vw'
  assign variant = product.selected_or_first_available_variant
  assign action = settings.card_quick_add
  if show_action == false
    assign action = false
  endif
  assign tag = heading_tag | default: 'h3'
  assign has_secondary = false
  if settings.card_show_secondary_image and product.media.size > 1
    assign has_secondary = true
  endif

  assign subtitle = product.metafields.custom.subtitle.value
  if subtitle == blank and settings.card_show_subtitle
    if product.has_only_default_variant
      assign subtitle = product.type
    else
      assign parts = ''
      for option in product.options_with_values limit: 2
        assign first_value = option.values.first
        assign last_value = option.values.last
        if option.values.size > 1
          assign part = first_value | append: '–' | append: last_value
        else
          assign part = first_value
        endif
        if parts == ''
          assign parts = part
        else
          assign parts = parts | append: ' · ' | append: part
        endif
      endfor
      assign subtitle = parts
    endif
  endif
-%}
<article class="product-card{% unless product.available %} is-sold-out{% endunless %}">
  <a
    class="product-card__media"
    href="{{ product.url }}"
    tabindex="-1"
    aria-hidden="true"
  >
    {%- if product.featured_media -%}
      {% render 'image',
        image: product.featured_media.preview_image,
        sizes: sizes_attr,
        widths: '240, 360, 480, 640, 800',
        priority: priority,
        class: 'product-card__image'
      %}
      {%- if has_secondary -%}
        {% render 'image',
          image: product.media[1].preview_image,
          sizes: sizes_attr,
          widths: '240, 360, 480, 640, 800',
          class: 'product-card__image product-card__image--secondary',
          alt: ''
        %}
      {%- endif -%}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </a>

  <div class="product-card__badges">
    {%- if product.available == false -%}
      <span class="badge badge--muted">{{ 'products.sold_out' | t }}</span>
    {%- elsif product.compare_at_price > product.price -%}
      {%- assign discount = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price -%}
      <span class="badge badge--sale">−{{ discount }}%</span>
    {%- endif -%}
    {%- for t in product.tags -%}
      {%- assign tag_lower = t | downcase -%}
      {%- if tag_lower contains 'badge:' -%}
        <span class="badge">{{ t | split: ':' | last | strip }}</span>
      {%- endif -%}
    {%- endfor -%}
  </div>

  <div class="product-card__body">
    <{{ tag }} class="product-card__heading text-sm">
      <a class="product-card__title" href="{{ product.url }}">{{ product.title | escape }}</a>
    </{{ tag }}>
    {%- if subtitle != blank -%}
      <span class="product-card__meta">{{ subtitle | escape }}</span>
    {%- endif -%}
    {% render 'price', product: product, show_from: true %}
  </div>

  {%- if action -%}
    <div class="product-card__action">
      {%- if product.available == false -%}
        <button type="button" class="button button--secondary button--sm button--full" disabled>
          {{ 'products.sold_out' | t }}
        </button>
      {%- elsif product.has_only_default_variant or product.variants.size == 1 -%}
        <product-form>
          {%- form 'product', product, class: 'product-card__form', novalidate: 'novalidate' -%}
            <input type="hidden" name="id" value="{{ variant.id }}">
            <input type="hidden" name="quantity" value="1">
            <button type="submit" name="add" class="button button--secondary button--sm button--full">
              {{ 'products.add_short' | t }}
            </button>
          {%- endform -%}
        </product-form>
        <script type="module" src="{{ 'product-form.js' | asset_url }}"></script>
      {%- else -%}
        <button
          type="button"
          class="button button--secondary button--sm button--full"
          data-quick-add="{{ product.url }}"
          aria-haspopup="dialog"
        >
          {{ 'products.choose_options' | t }}
        </button>
      {%- endif -%}
    </div>
  {%- endif -%}
</article>
