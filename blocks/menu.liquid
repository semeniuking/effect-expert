{%- doc -%}
  Vertical link list with optional heading. Collapses to an accordion on mobile when enabled (used in the footer).
{%- enddoc -%}
{%- assign menu = block.settings.menu -%}
<div class="menu-block{% if block.settings.collapse_mobile %} menu-block--collapse{% endif %}" {{ block.shopify_attributes }}>
  <details class="menu-block__details" open data-menu-block>
    <summary class="menu-block__heading eyebrow{% if block.settings.heading == blank %} visually-hidden{% endif %}">
      {{ block.settings.heading | default: menu.title | escape }}
      <span class="icon-plus-minus" aria-hidden="true"></span>
    </summary>
    <ul class="menu-block__list" role="list">
      {%- for link in menu.links -%}
        <li>
          <a
            class="menu-block__link"
            href="{{ link.url }}"
            {% if link.current %}
              aria-current="page"
            {% endif %}
          >
            {{- link.title | escape -}}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </details>
</div>
<script>
  // Collapse footer menus on small screens without loading a module.
  (() => {
    const el = document.currentScript.previousElementSibling;
    if (el?.classList.contains('menu-block--collapse') && matchMedia('(max-width: 749px)').matches) {
      el.querySelector('details')?.removeAttribute('open');
    }
  })();
</script>

{% stylesheet %}
  .menu-block__heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    list-style: none;
    margin-bottom: 12px;
    color: var(--color-text-muted);
    pointer-events: none;
  }

  .menu-block__heading::-webkit-details-marker {
    display: none;
  }

  .menu-block__heading .icon-plus-minus {
    display: none;
  }

  .menu-block__list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 0;
    list-style: none;
    font-size: 14px;
  }

  .menu-block__link {
    color: inherit;
    text-decoration: none;
  }

  .menu-block__link:hover,
  .menu-block__link[aria-current='page'] {
    color: var(--color-accent);
  }

  @media (max-width: 749px) {
    .menu-block--collapse {
      border-bottom: 1px solid var(--color-line);
    }

    .menu-block--collapse .menu-block__heading {
      min-height: 56px;
      margin: 0;
      pointer-events: auto;
      cursor: pointer;
      color: inherit;
      font-weight: 600;
    }

    .menu-block--collapse .menu-block__heading .icon-plus-minus {
      display: block;
    }

    .menu-block--collapse .menu-block__list {
      padding-bottom: 20px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.menu.name",
  "tag": null,
  "settings": [
    { "type": "text", "id": "heading", "label": "t:shared.heading.label", "default": "Каталог" },
    { "type": "link_list", "id": "menu", "label": "t:blocks.menu.settings.menu.label", "default": "footer" },
    { "type": "checkbox", "id": "collapse_mobile", "label": "t:blocks.menu.settings.collapse_mobile.label", "default": true }
  ],
  "presets": [{ "name": "t:blocks.menu.name", "category": "t:categories.links" }]
}
{% endschema %}
