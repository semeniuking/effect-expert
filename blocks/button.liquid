{%- doc -%}
  Link styled as a button.
{%- enddoc -%}
{%- liquid
  assign classes = 'button'
  case block.settings.style
    when 'secondary'
      assign classes = classes | append: ' button--secondary'
    when 'accent'
      assign classes = classes | append: ' button--accent'
    when 'link'
      assign classes = 'link-arrow'
  endcase
  if block.settings.full_width
    assign classes = classes | append: ' button--full'
  endif
-%}
<a
  class="button-block {{ classes }}{% if block.settings.full_width_mobile %} button-block--full-mobile{% endif %}"
  {% if block.settings.link != blank %}
    href="{{ block.settings.link }}"
  {% else %}
    role="link" aria-disabled="true"
  {% endif %}
  {% if block.settings.new_tab %}
    target="_blank" rel="noopener"
  {% endif %}
  {{ block.shopify_attributes }}
>
  {{- block.settings.label | escape -}}
  {%- if block.settings.style == 'link' %} →{% endif -%}
</a>

{% stylesheet %}
  @media (max-width: 749px) {
    .button-block--full-mobile.button {
      width: 100%;
      min-height: 52px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.button.name",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:blocks.button.settings.label.label",
      "default": "До шопінгу"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:blocks.button.settings.link.label"
    },
    {
      "type": "checkbox",
      "id": "new_tab",
      "label": "t:blocks.button.settings.new_tab.label",
      "default": false
    },
    {
      "type": "select",
      "id": "style",
      "label": "t:blocks.button.settings.style.label",
      "options": [
        { "value": "primary", "label": "t:blocks.button.settings.style.options__primary" },
        { "value": "secondary", "label": "t:blocks.button.settings.style.options__secondary" },
        { "value": "accent", "label": "t:blocks.button.settings.style.options__accent" },
        { "value": "link", "label": "t:blocks.button.settings.style.options__link" }
      ],
      "default": "primary"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:blocks.button.settings.full_width.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "full_width_mobile",
      "label": "t:blocks.button.settings.full_width_mobile.label",
      "default": true
    }
  ],
  "presets": [{ "name": "t:blocks.button.name", "category": "t:categories.links" }]
}
{% endschema %}
