{%- doc -%}
  Shopify-hosted video (autoplay muted loop) or YouTube/Vimeo embed loaded on click.
{%- enddoc -%}
<div class="video-block media" style="--ratio: {{ block.settings.ratio }};" {{ block.shopify_attributes }}>
  {%- if block.settings.video != blank -%}
    {{
      block.settings.video
      | video_tag:
        autoplay: block.settings.autoplay,
        loop: block.settings.autoplay,
        muted: block.settings.autoplay,
        controls: block.settings.controls,
        playsinline: true,
        preload: 'metadata',
        image_size: '1100x'
    }}
  {%- elsif block.settings.video_url != blank -%}
    <details class="video-block__embed">
      <summary aria-label="{{ 'general.play_video' | t }}">
        {% render 'image', image: block.settings.cover, sizes: '100vw', placeholder: 'lifestyle-2' %}
        <span class="video-block__play" aria-hidden="true">▶</span>
      </summary>
      {%- if block.settings.video_url.type == 'youtube' -%}
        <iframe
          src="https://www.youtube-nocookie.com/embed/{{ block.settings.video_url.id }}?autoplay=1&rel=0"
          title="{{ block.settings.cover.alt | default: 'Video' | escape }}"
          allow="autoplay; encrypted-media; picture-in-picture"
          allowfullscreen
          loading="lazy"
        ></iframe>
      {%- else -%}
        <iframe
          src="https://player.vimeo.com/video/{{ block.settings.video_url.id }}?autoplay=1"
          title="{{ block.settings.cover.alt | default: 'Video' | escape }}"
          allow="autoplay; fullscreen; picture-in-picture"
          allowfullscreen
          loading="lazy"
        ></iframe>
      {%- endif -%}
    </details>
  {%- else -%}
    {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
  {%- endif -%}
</div>

{% stylesheet %}
  .video-block {
    width: 100%;
  }

  .video-block video,
  .video-block iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
  }

  .video-block__embed,
  .video-block__embed summary {
    position: absolute;
    inset: 0;
    list-style: none;
    cursor: pointer;
  }

  .video-block__embed summary img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .video-block__embed[open] summary {
    display: none;
  }

  .video-block__play {
    position: absolute;
    inset: 50% auto auto 50%;
    translate: -50% -50%;
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--color-bg);
    color: var(--color-text);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.video.name",
  "tag": null,
  "settings": [
    { "type": "video", "id": "video", "label": "t:blocks.video.settings.video.label" },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "t:blocks.video.settings.video_url.label",
      "accept": ["youtube", "vimeo"]
    },
    { "type": "image_picker", "id": "cover", "label": "t:blocks.video.settings.cover.label" },
    {
      "type": "select",
      "id": "ratio",
      "label": "t:shared.ratio.label",
      "options": [
        { "value": "16/9", "label": "16:9" },
        { "value": "4/5", "label": "4:5" },
        { "value": "1/1", "label": "1:1" },
        { "value": "9/16", "label": "9:16" }
      ],
      "default": "16/9"
    },
    { "type": "checkbox", "id": "autoplay", "label": "t:blocks.video.settings.autoplay.label", "default": true },
    { "type": "checkbox", "id": "controls", "label": "t:blocks.video.settings.controls.label", "default": false }
  ],
  "presets": [{ "name": "t:blocks.video.name", "category": "t:categories.media" }]
}
{% endschema %}
