{%- doc -%}
  Custom Liquid / HTML snippet.
{%- enddoc -%}
<div class="custom-liquid-block" {{ block.shopify_attributes }}>
  {{ block.settings.custom_liquid }}
</div>

{% schema %}
{
  "name": "t:blocks.custom_liquid.name",
  "tag": null,
  "settings": [
    {
      "type": "liquid",
      "id": "custom_liquid",
      "label": "t:blocks.custom_liquid.settings.custom_liquid.label"
    }
  ],
  "presets": [{ "name": "t:blocks.custom_liquid.name", "category": "t:categories.advanced" }]
}
{% endschema %}
