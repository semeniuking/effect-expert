{%- doc -%}
  Newsletter signup (adds the email to Shopify customers with marketing consent).
{%- enddoc -%}
{%- liquid
  assign signup_form_id = 'EmailSignup-' | append: block.id
  assign signup_placeholder = block.settings.placeholder
  if signup_placeholder == blank
    assign signup_placeholder = 'newsletter.label' | t
  endif
-%}
<div class="email-signup" {{ block.shopify_attributes }}>
  {%- form 'customer', id: signup_form_id, class: 'email-signup__form' -%}
    <input type="hidden" name="contact[tags]" value="newsletter">
    {%- if form.posted_successfully? -%}
      <p class="form-message form-message--success" role="status" tabindex="-1" autofocus>
        {{ 'newsletter.success' | t }}
      </p>
    {%- else -%}
      <div class="input-group">
        <label class="visually-hidden" for="EmailSignupInput-{{ block.id }}">{{ 'newsletter.label' | t }}</label>
        <input
          id="EmailSignupInput-{{ block.id }}"
          class="input email-signup__input"
          type="email"
          name="contact[email]"
          autocomplete="email"
          required
          placeholder="{{ signup_placeholder | escape }}"
          {% if form.errors %}
            aria-invalid="true" aria-describedby="EmailSignupError-{{ block.id }}"
          {% endif %}
        >
        <button type="submit" class="button">{{ block.settings.button_label | escape }}</button>
      </div>
      {%- if form.errors -%}
        <p id="EmailSignupError-{{ block.id }}" class="form-message form-message--error">
          {{ form.errors.translated_fields.email | capitalize }}
          {{ form.errors.messages.email }}
        </p>
      {%- endif -%}
    {%- endif -%}
  {%- endform -%}
</div>

{% stylesheet %}
  .email-signup {
    width: 100%;
    max-width: 480px;
  }

  .email-signup__input {
    background: transparent;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.email_signup.name",
  "tag": null,
  "settings": [
    { "type": "text", "id": "placeholder", "label": "t:blocks.email_signup.settings.placeholder.label", "default": "Ваш email" },
    { "type": "text", "id": "button_label", "label": "t:blocks.email_signup.settings.button_label.label", "default": "OK" }
  ],
  "presets": [{ "name": "t:blocks.email_signup.name", "category": "t:categories.forms" }]
}
{% endschema %}
