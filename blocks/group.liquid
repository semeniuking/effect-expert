{%- doc -%}
  Layout container that can hold any theme block (including other groups), so content can be nested and rearranged freely.
{%- enddoc -%}
{%- liquid
  assign style = ''
  if block.settings.width == 'custom'
    assign style = style | append: '--group-width: ' | append: block.settings.custom_width | append: '%;'
  endif
-%}
<div
  class="group group--{{ block.settings.direction }} group--w-{{ block.settings.width }}{% if block.settings.stack_mobile %} group--stack-mobile{% endif %}{% if block.settings.use_scheme %} color-{{ block.settings.color_scheme }} group--scheme{% endif %}"
  style="--gap: {{ block.settings.gap }}px; --justify: {{ block.settings.justify }}; --align: {{ block.settings.align }}; --pad-y: {{ block.settings.padding_y }}px; --pad-x: {{ block.settings.padding_x }}px; --text-align: {{ block.settings.text_align }}; {{ style }}"
  {{ block.shopify_attributes }}
>
  {%- if block.settings.link != blank -%}
    <a class="full-width-link" href="{{ block.settings.link }}" aria-label="{{ block.settings.link_label | escape }}"></a>
  {%- endif -%}
  {% content_for 'blocks' %}
</div>

{% stylesheet %}
  .group {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--gap);
    justify-content: var(--justify);
    align-items: var(--align);
    padding: var(--pad-y) var(--pad-x);
    text-align: var(--text-align);
    min-width: 0;
  }

  .group--scheme {
    background: var(--color-bg);
    color: var(--color-text);
    border-radius: var(--radius-card);
  }

  .group--row {
    flex-direction: row;
    flex-wrap: wrap;
  }

  .group--column {
    justify-content: flex-start;
    align-items: stretch;
  }

  .group--column > * {
    align-self: var(--align);
  }

  .group--w-fill {
    flex: 1 1 0;
    width: 100%;
  }

  .group--w-fit {
    flex: 0 0 auto;
  }

  .group--w-custom {
    flex: 0 0 auto;
    width: 100%;
  }

  @media (min-width: 750px) {
    .group--w-custom {
      width: var(--group-width);
    }
  }

  @media (max-width: 749px) {
    .group--stack-mobile.group--row {
      flex-direction: column;
      align-items: stretch;
    }

    .group {
      padding: calc(var(--pad-y) * 0.75) calc(var(--pad-x) * 0.6);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.group.name",
  "tag": null,
  "blocks": [{ "type": "@theme" }, { "type": "@app" }],
  "settings": [
    {
      "type": "select",
      "id": "direction",
      "label": "t:shared.direction.label",
      "options": [
        { "value": "column", "label": "t:shared.direction.options__column" },
        { "value": "row", "label": "t:shared.direction.options__row" }
      ],
      "default": "column"
    },
    {
      "type": "checkbox",
      "id": "stack_mobile",
      "label": "t:blocks.group.settings.stack_mobile.label",
      "default": true,
      "visible_if": "{{ block.settings.direction == 'row' }}"
    },
    {
      "type": "select",
      "id": "justify",
      "label": "t:shared.justify.label",
      "options": [
        { "value": "flex-start", "label": "t:shared.alignment.options__start" },
        { "value": "center", "label": "t:shared.alignment.options__center" },
        { "value": "flex-end", "label": "t:shared.alignment.options__end" },
        { "value": "space-between", "label": "t:shared.alignment.options__space_between" }
      ],
      "default": "flex-start"
    },
    {
      "type": "select",
      "id": "align",
      "label": "t:shared.align.label",
      "options": [
        { "value": "flex-start", "label": "t:shared.alignment.options__start" },
        { "value": "center", "label": "t:shared.alignment.options__center" },
        { "value": "flex-end", "label": "t:shared.alignment.options__end" },
        { "value": "stretch", "label": "t:shared.alignment.options__stretch" }
      ],
      "default": "flex-start"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "t:shared.text_align.label",
      "options": [
        { "value": "left", "label": "t:shared.alignment.options__left" },
        { "value": "center", "label": "t:shared.alignment.options__center" },
        { "value": "right", "label": "t:shared.alignment.options__right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:shared.gap.label",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:blocks.group.settings.width.label",
      "options": [
        { "value": "fill", "label": "t:blocks.group.settings.width.options__fill" },
        { "value": "fit", "label": "t:blocks.group.settings.width.options__fit" },
        { "value": "custom", "label": "t:blocks.group.settings.width.options__custom" }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "t:blocks.group.settings.custom_width.label",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "header",
      "content": "t:shared.header_appearance.content"
    },
    {
      "type": "checkbox",
      "id": "use_scheme",
      "label": "t:blocks.group.settings.use_scheme.label",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.color_scheme.label",
      "default": "scheme-2",
      "visible_if": "{{ block.settings.use_scheme }}"
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "t:shared.padding_y.label",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_x",
      "label": "t:shared.padding_x.label",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:shared.header_link.content"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:blocks.group.settings.link.label"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:blocks.group.settings.link_label.label",
      "visible_if": "{{ block.settings.link != blank }}"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.group.presets.column",
      "category": "t:categories.layout",
      "settings": { "direction": "column" }
    },
    {
      "name": "t:blocks.group.presets.row",
      "category": "t:categories.layout",
      "settings": { "direction": "row", "align": "center" }
    },
    {
      "name": "t:blocks.group.presets.card",
      "category": "t:categories.layout",
      "settings": { "direction": "column", "use_scheme": true, "color_scheme": "scheme-2", "padding_y": 24, "padding_x": 24 },
      "blocks": {
        "heading": { "type": "heading", "settings": { "text": "Заголовок", "style": "h3" } },
        "text": { "type": "text", "settings": { "text": "<p>Короткий опис.</p>" } }
      },
      "block_order": ["heading", "text"]
    }
  ]
}
{% endschema %}
