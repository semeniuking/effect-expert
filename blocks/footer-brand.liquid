{%- doc -%}
  Footer brand column: logo for dark backgrounds (falls back to the main logo, then the shop name), a short text and social icons.
{%- enddoc -%}
{%- liquid
  assign logo = settings.logo_inverse | default: settings.logo
  assign logo_h = block.settings.logo_height
  if logo != blank
    assign logo_ratio = logo.aspect_ratio | default: 3
    assign logo_w = logo_h | times: logo_ratio | ceil
    assign logo_w2 = logo_w | times: 2
    assign logo_w3 = logo_w | times: 3
    assign logo_widths = logo_w | append: ', ' | append: logo_w2 | append: ', ' | append: logo_w3
    assign logo_sizes = logo_w | append: 'px'
  endif
-%}
<div class="footer-brand" {{ block.shopify_attributes }}>
  <a class="footer-brand__logo" href="{{ routes.root_url }}" style="--brand-logo-h: {{ logo_h }}px;">
    {%- if logo != blank -%}
      {{
        logo
        | image_url: width: logo_w3
        | image_tag:
          class: 'footer-brand__logo-img',
          alt: shop.name,
          width: logo_w,
          height: logo_h,
          widths: logo_widths,
          sizes: logo_sizes
      }}
    {%- else -%}
      <span class="footer-brand__name">{{ shop.name | escape }}</span>
    {%- endif -%}
  </a>
  {%- if block.settings.text != blank -%}
    <div class="footer-brand__text rte">{{ block.settings.text }}</div>
  {%- endif -%}
  {%- if block.settings.show_social -%}
    {% render 'social-icons', class: 'footer-brand__social' %}
  {%- endif -%}
</div>

{% stylesheet %}
  .footer-brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  .footer-brand__logo {
    display: inline-flex;
    color: inherit;
    text-decoration: none;
  }

  .footer-brand__logo-img {
    width: auto;
    height: var(--brand-logo-h);
    max-width: 100%;
    object-fit: contain;
  }

  .footer-brand__name {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .footer-brand__text {
    max-width: 260px;
    color: var(--color-text-muted);
    font-size: 14px;
    line-height: 20px;
  }

  .footer-brand__social {
    margin-inline: -10px;
  }

  @media (max-width: 749px) {
    .footer-brand {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
    }

    .footer-brand__text {
      grid-column: 1 / -1;
      grid-row: 2;
    }

    .footer-brand__social {
      grid-column: 2;
      grid-row: 1;
      margin-inline: 0 -10px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.footer_brand.name",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:blocks.footer_brand.settings.logo_info.content"
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "t:blocks.footer_brand.settings.logo_height.label",
      "min": 20,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:blocks.footer_brand.settings.text.label",
      "default": "<p>Професійні матеріали для нарощування вій. Доставка Новою поштою та Укрпоштою по всій Україні.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "t:blocks.footer_brand.settings.show_social.label",
      "info": "t:blocks.footer_brand.settings.show_social.info",
      "default": true
    }
  ],
  "presets": [{ "name": "t:blocks.footer_brand.name", "category": "t:categories.text" }]
}
{% endschema %}
