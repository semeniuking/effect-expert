{%- doc -%}
  Empty vertical space.
{%- enddoc -%}
<div
  class="spacer-block"
  style="--space: {{ block.settings.height }}px; --space-mobile: {{ block.settings.height_mobile }}px;"
  {{ block.shopify_attributes }}
></div>

{% stylesheet %}
  .spacer-block {
    height: var(--space-mobile);
    flex: none;
  }

  @media (min-width: 750px) {
    .spacer-block {
      height: var(--space);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.spacer.name",
  "tag": null,
  "settings": [
    { "type": "range", "id": "height", "label": "t:blocks.spacer.settings.height.label", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "height_mobile", "label": "t:blocks.spacer.settings.height_mobile.label", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24 }
  ],
  "presets": [{ "name": "t:blocks.spacer.name", "category": "t:categories.layout" }]
}
{% endschema %}
