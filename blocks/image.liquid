{%- doc -%}
  Image with optional link, aspect ratio and separate mobile image.
{%- enddoc -%}
{%- liquid
  assign ratio = block.settings.ratio
  if ratio == 'adapt' and block.settings.image != blank
    assign ratio = block.settings.image.aspect_ratio
  elsif ratio == 'adapt'
    assign ratio = '4/3'
  endif
  assign sizes = '(min-width: 750px) ' | append: block.settings.desktop_size | append: 'vw, 100vw'
-%}
{%- comment -%} Empty image blocks show a placeholder only in the theme editor. {%- endcomment -%}
{%- if block.settings.image != blank or request.design_mode -%}
<div
  class="image-block media{% if block.settings.image_mobile != blank %} image-block--has-mobile{% endif %}"
  style="--ratio: {{ ratio }}; --image-width: {{ block.settings.width }}%;"
  {{ block.shopify_attributes }}
>
  {%- if block.settings.link != blank -%}
    <a class="full-width-link" href="{{ block.settings.link }}" aria-label="{{ block.settings.image.alt | default: block.settings.link_label | escape }}"></a>
  {%- endif -%}
  {% render 'image',
    image: block.settings.image,
    sizes: sizes,
    priority: block.settings.priority,
    class: 'image-block__desktop',
    placeholder: 'lifestyle-1'
  %}
  {%- if block.settings.image_mobile != blank -%}
    {% render 'image',
      image: block.settings.image_mobile,
      sizes: '100vw',
      priority: block.settings.priority,
      class: 'image-block__mobile'
    %}
  {%- endif -%}
</div>
{%- endif -%}

{% stylesheet %}
  .image-block {
    width: var(--image-width);
    max-width: 100%;
  }

  .image-block__mobile {
    display: none;
  }

  @media (max-width: 749px) {
    .image-block {
      width: 100%;
    }

    .image-block--has-mobile .image-block__desktop {
      display: none;
    }

    .image-block--has-mobile .image-block__mobile {
      display: block;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.image.name",
  "tag": null,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "t:blocks.image.settings.image.label" },
    { "type": "image_picker", "id": "image_mobile", "label": "t:blocks.image.settings.image_mobile.label" },
    {
      "type": "select",
      "id": "ratio",
      "label": "t:shared.ratio.label",
      "options": [
        { "value": "adapt", "label": "t:shared.ratio.options__adapt" },
        { "value": "1/1", "label": "1:1" },
        { "value": "4/5", "label": "4:5" },
        { "value": "3/4", "label": "3:4" },
        { "value": "4/3", "label": "4:3" },
        { "value": "16/9", "label": "16:9" },
        { "value": "12/5", "label": "12:5" }
      ],
      "default": "adapt"
    },
    {
      "type": "range",
      "id": "width",
      "label": "t:blocks.image.settings.width.label",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "desktop_size",
      "label": "t:blocks.image.settings.desktop_size.label",
      "info": "t:blocks.image.settings.desktop_size.info",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    { "type": "url", "id": "link", "label": "t:shared.link.label" },
    { "type": "text", "id": "link_label", "label": "t:shared.link_label.label", "visible_if": "{{ block.settings.link != blank }}" },
    {
      "type": "checkbox",
      "id": "priority",
      "label": "t:blocks.image.settings.priority.label",
      "info": "t:blocks.image.settings.priority.info",
      "default": false
    }
  ],
  "presets": [{ "name": "t:blocks.image.name", "category": "t:categories.media" }]
}
{% endschema %}
