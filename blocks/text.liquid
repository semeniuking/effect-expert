{%- doc -%}
  Rich text paragraph(s).
{%- enddoc -%}
<div
  class="text-block rte text-block--{{ block.settings.size }}{% if block.settings.muted %} text-muted{% endif %}"
  style="--text-max: {{ block.settings.max_width }}ch;"
  {{ block.shopify_attributes }}
>
  {{ block.settings.text }}
</div>

{% stylesheet %}
  .text-block {
    max-width: var(--text-max);
  }

  .text-block--lg {
    font-size: 18px;
    line-height: 28px;
  }

  .text-block--sm {
    font-size: 14px;
    line-height: 20px;
  }

  @media (max-width: 749px) {
    .text-block--lg {
      font-size: 16px;
      line-height: 24px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.text.name",
  "tag": null,
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "t:blocks.text.settings.text.label",
      "default": "<p>Текст, що розповідає про ваш бренд.</p>"
    },
    {
      "type": "select",
      "id": "size",
      "label": "t:blocks.text.settings.size.label",
      "options": [
        { "value": "sm", "label": "t:shared.size.options__small" },
        { "value": "md", "label": "t:shared.size.options__medium" },
        { "value": "lg", "label": "t:shared.size.options__large" }
      ],
      "default": "md"
    },
    {
      "type": "checkbox",
      "id": "muted",
      "label": "t:blocks.text.settings.muted.label",
      "default": false
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "t:blocks.text.settings.max_width.label",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "ch",
      "default": 60
    }
  ],
  "presets": [{ "name": "t:blocks.text.name", "category": "t:categories.text" }]
}
{% endschema %}
