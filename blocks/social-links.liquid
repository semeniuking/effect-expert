{%- doc -%}
  Social profile icons (profiles are set in Theme settings → Social media).
{%- enddoc -%}
<div class="social-links-block" {{ block.shopify_attributes }}>
  {% render 'social-icons', show_labels: block.settings.show_labels %}
</div>

{% stylesheet %}
  .social-icons {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
    margin: 0 -10px;
    padding: 0;
    list-style: none;
  }

  .social-icons__link {
    color: inherit;
    text-decoration: none;
  }

  .social-icons__link:not(.icon-button) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 10px;
    font-size: 14px;
  }

  .social-icons__link:hover {
    color: var(--color-accent);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.social_links.name",
  "tag": null,
  "settings": [
    { "type": "paragraph", "content": "t:blocks.social_links.settings.info.content" },
    { "type": "checkbox", "id": "show_labels", "label": "t:blocks.social_links.settings.show_labels.label", "default": false }
  ],
  "presets": [{ "name": "t:blocks.social_links.name", "category": "t:categories.links" }]
}
{% endschema %}
