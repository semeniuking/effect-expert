{%- doc -%}
  One collapsible row. Content: rich text, a page's content, and/or nested blocks.
{%- enddoc -%}
<details class="accordion"{% if block.settings.open %} open{% endif %} {{ block.shopify_attributes }}>
  <summary class="accordion__summary">
    {{ block.settings.heading | escape }}
    <span class="icon-plus-minus" aria-hidden="true"></span>
  </summary>
  <div class="accordion__content rte">
    {{ block.settings.content }}
    {%- if block.settings.page != blank -%}
      {{ block.settings.page.content }}
    {%- endif -%}
    {% content_for 'blocks' %}
  </div>
</details>

{% schema %}
{
  "name": "t:blocks.accordion_row.name",
  "tag": null,
  "blocks": [{ "type": "@theme" }, { "type": "@app" }],
  "settings": [
    { "type": "text", "id": "heading", "label": "t:shared.heading.label", "default": "Питання" },
    { "type": "richtext", "id": "content", "label": "t:blocks.accordion_row.settings.content.label" },
    { "type": "page", "id": "page", "label": "t:blocks.accordion_row.settings.page.label" },
    { "type": "checkbox", "id": "open", "label": "t:blocks.accordion_row.settings.open.label", "default": false }
  ],
  "presets": [{ "name": "t:blocks.accordion_row.name" }]
}
{% endschema %}
