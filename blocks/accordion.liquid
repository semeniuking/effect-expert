{%- doc -%}
  Collapsible rows (FAQ, product details). Rows can contain any blocks.
{%- enddoc -%}
<div class="accordion-block" {{ block.shopify_attributes }}>
  {% content_for 'blocks' %}
</div>

{% stylesheet %}
  .accordion-block {
    width: 100%;
    border-top: 1px solid var(--color-line);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.accordion.name",
  "tag": null,
  "blocks": [{ "type": "_accordion-row" }],
  "presets": [
    {
      "name": "t:blocks.accordion.name",
      "category": "t:categories.layout",
      "blocks": {
        "row_1": { "type": "_accordion-row", "settings": { "heading": "Доставка та оплата", "open": true } },
        "row_2": { "type": "_accordion-row", "settings": { "heading": "Обмін і повернення" } }
      },
      "block_order": ["row_1", "row_2"]
    }
  ]
}
{% endschema %}
